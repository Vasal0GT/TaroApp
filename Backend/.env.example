# AI reading generation
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
READING_WORKER_OPENAI_RPS=7
READING_WORKER_CONCURRENT_LIMIT=20
READING_WORKER_PREFETCH_COUNT=20

# PostgreSQL
POSTGRES_DB=taro
POSTGRES_USER=taro
POSTGRES_PASSWORD=replace_with_database_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=taro
RABBITMQ_DEFAULT_PASS=replace_with_rabbitmq_password
RABBITMQ_QUEUE_NAME=tarot-readings

# Authentication
JWT_ISSUER=Taro
JWT_AUDIENCE=Taro.Mobile
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# YooKassa
YOOKASSA_SHOP_ID=replace_with_shop_id
YOOKASSA_SECRET_KEY=replace_with_yookassa_secret_key
YOOKASSA_RETURN_URL=http://localhost:3000/payment-result

# Billing portal
BILLING_PORTAL_BASE_URL=http://localhost:3000
BILLING_PORTAL_API_BASE_URL=http://localhost:5000

# Email
MAIL_SMTP_USERNAME=replace_with_smtp_username
MAIL_SMTP_PASSWORD=replace_with_smtp_password
MAIL_FROM_NAME=Taro

# External authentication
GOOGLE_WEB_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_IOS_CLIENT_ID=replace_with_google_ios_client_id
GOOGLE_ANDROID_CLIENT_ID=replace_with_google_android_client_id
APPLE_EXPO_AUDIENCE=host.exp.Exponent
APPLE_BUNDLE_ID=com.example.taro
