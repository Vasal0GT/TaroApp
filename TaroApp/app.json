{
  "expo": {
    "name": "TaroApp",
    "slug": "TaroApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "taroapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0718",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.vastudio.taro",
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "package": "com.vastudio.taro",
      "adaptiveIcon": {
        "backgroundColor": "#0B0718",
        "foregroundImage": "./assets/images/app-icon-foreground.png"
      },
      "newArchEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0718",
          "image": "./assets/images/splash-app-icon.png",
          "android": {
            "image": "./assets/images/splash-app-icon.png",
            "imageWidth": 76,
            "backgroundColor": "#0B0718"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "hidden": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "4b191aa0-7d22-4e44-a45b-17e5708272fc"
      }
    }
  }
}
